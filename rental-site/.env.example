DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer les cookies de session admin — changez cette valeur en production
SESSION_SECRET="replace-with-a-long-random-string"

# Compte admin créé par `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Administrateur"

# Adresse recevant les notifications de check-in (optionnel, sinon consultable dans /admin)
ADMIN_NOTIFY_EMAIL="admin@example.com"

# URL publique du site, utilisée pour générer les liens d'export iCal (/api/ical/...)
PUBLIC_BASE_URL="http://localhost:3000"

# Configuration SMTP optionnelle — si absente, les e-mails sont simulés et journalisés
# (consultables dans /admin) plutôt qu'envoyés réellement.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
